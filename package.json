{
  "name": "swear",
  "version": "2.0.2",
  "description": "🙏 Flexible promise handling with Javascript",
  "repository": "github:franciscop/swear",
  "author": "Francisco Presencia <public@francisco.io> (https://francisco.io/)",
  "funding": "https://www.paypal.me/franciscopresencia/19",
  "license": "MIT",
  "keywords": [
    "promise",
    "async",
    "manipulation",
    "array",
    "number",
    "object",
    "map",
    "filter"
  ],
  "scripts": {
    "build": "npm run build:bundle && npm run build:types && npm run build:prettier",
    "build:bundle": "bun build src/index.ts --outfile=index.min.js --minify --format=esm",
    "build:types": "dts-bundle-generator -o index.d.ts src/index.ts",
    "build:prettier": "prettier --write src *.ts *.json",
    "lint": "oxlint src && tsc",
    "size": "echo $(gzip -c index.min.js | wc -c) bytes",
    "start": "bun test --watch",
    "test": "bun test"
  },
  "main": "index.min.js",
  "type": "module",
  "types": "index.d.ts",
  "files": [
    "index.min.js",
    "index.d.ts"
  ],
  "devDependencies": {
    "@endosome/dts-bundle-generator": "9.6.0",
    "@types/bun": "^1.4.4",
    "@types/node": "^26.6.5",
    "oxlint": "^1.89.0",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2"
  }
}
