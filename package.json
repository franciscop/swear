{
  "name": "swear",
  "version": "2.0.1",
  "description": "🙏 Flexible promise handling with Javascript",
  "repository": "github:franciscop/swear",
  "author": "Francisco Presencia <public@francisco.io> (https://francisco.io/)",
  "funding": "https://www.paypal.me/franciscopresencia/19",
  "license": "MIT",
  "keywords": [
    "promise",
    "async",
    "manipulation",
    "array",
    "number",
    "object",
    "map",
    "filter"
  ],
  "scripts": {
    "build": "npm run build:bundle && npm run build:types",
    "build:bundle": "bun build src/index.ts --outfile=index.min.js --minify --format=esm",
    "build:types": "dts-bundle-generator -o index.d.ts src/index.ts",
    "lint": "tsc",
    "size": "echo $(gzip -c index.min.js | wc -c) bytes",
    "start": "bun test --watch",
    "test": "bun test"
  },
  "main": "index.min.js",
  "type": "module",
  "types": "index.d.ts",
  "files": [
    "index.min.js",
    "index.d.ts"
  ],
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "@types/node": "^25.5.0",
    "dts-bundle-generator": "^9.5.1",
    "typescript": "5.9"
  }
}
